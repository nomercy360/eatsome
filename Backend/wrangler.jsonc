{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "eatsome-api",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  "secrets": {
    "required": [
      "OPENAI_API_KEY",
      "GEMINI_API_KEY",
      "ANTHROPIC_API_KEY",
      "QWEN_API_KEY",
      "EATSOME_API_TOKEN"
    ]
  },
  "vars": {
    "ACCOUNT_ID": "anonymous",
    // The `aud` of a Sign in with Apple token from a native app is the bundle
    // id. A vars entry rather than a secret: it is printed in every App Store
    // listing, and a value nobody can keep secret should not be stored as if
    // they could.
    "APPLE_CLIENT_IDS": "app.shaman.tracker",
    // Empty on purpose. Google's server half is implemented and its client half
    // is not, so a sign-in attempt should fail as unconfigured rather than
    // succeed against an audience list nobody set.
    "GOOGLE_CLIENT_IDS": "",
    "RECOGNITION_PROVIDER": "gemini",
    "OPENAI_RECOGNITION_MODEL": "gpt-5.6-luna",
    "GEMINI_RECOGNITION_MODEL": "gemini-3.6-flash",
    "ANTHROPIC_RECOGNITION_MODEL": "claude-haiku-4-5-20251001",
    "QWEN_RECOGNITION_MODEL": "qwen3.7-flash",
    "QWEN_BASE_URL": "https://dashscope-intl.aliyuncs.com/compatible-mode/v1",
    "OPENAI_IMAGE_DETAIL": "high",
    "MEAL_PROMPT_VERSION": "meal-v19-2026-08-10",
    "RECOGNITIONS_PER_DAY": "400",
    "RECOGNITIONS_PER_DEVICE_PER_DAY": "40"
  },
  // Per-colo, so this is a burst dampener rather than a spend ceiling — the
  // daily budget in the worker is what actually bounds the bill.
  "ratelimits": [
    {
      "name": "RECOGNITION_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 12, "period": 60 }
    },
    {
      "name": "SYNC_LIMIT",
      "namespace_id": "1002",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "eatsome-media"
    }
  ],
  "triggers": {
    "crons": ["0 3 * * SUN"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "eatsome",
      "database_id": "4d917567-d6a1-4e35-ad87-28f408010e5f",
      "migrations_dir": "migrations"
    }
  ]
}
