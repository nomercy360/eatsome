{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "eatsome-api",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  "secrets": {
    "required": ["GEMINI_API_KEY"]
  },
  "vars": {
    "ACCOUNT_ID": "anonymous",
    // The `aud` of a Sign in with Apple token from a native app is the bundle
    // id. A vars entry rather than a secret: it is printed in every App Store
    // listing, and a value nobody can keep secret should not be stored as if
    // they could.
    "APPLE_CLIENT_IDS": "app.shaman.tracker",
    "GEMINI_RECOGNITION_MODEL": "gemini-3.7-flash",
    // Search as a tool on the recognition call itself. This is what fixes a
    // chain's numbers: the model searches when the food is branded, ignores
    // search when it is not, and answers in the same schema either way.
    "RECOGNITION_SEARCH": "on",
    "RECOGNITIONS_PER_DAY": "400",
    "RECOGNITIONS_PER_DEVICE_PER_DAY": "40"
  },
  // Per-colo, so this is a burst dampener rather than a spend ceiling — the
  // daily budget in the worker is what actually bounds the bill.
  "ratelimits": [
    {
      "name": "RECOGNITION_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 12, "period": 60 }
    },
    {
      "name": "SYNC_LIMIT",
      "namespace_id": "1002",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "eatsome-media"
    }
  ],
  "triggers": {
    "crons": ["0 3 * * SUN"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "eatsome",
      "database_id": "c9128364-2ffa-4ab4-b42d-a03fa9d8cf53",
      "migrations_dir": "migrations"
    }
  ]
}
