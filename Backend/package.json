{
  "name": "eatsome-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24.14 <25"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "pnpm verify && wrangler deploy",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.eval.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "verify": "pnpm typecheck && pnpm test && pnpm check",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply eatsome --local",
    "db:migrate:remote": "wrangler d1 migrations apply eatsome --remote",
    "taxonomy:audit": "node scripts/migrate-food-taxonomy.mjs --audit",
    "taxonomy:migrate": "node scripts/migrate-food-taxonomy.mjs --apply",
    "cf:typegen": "wrangler types",
    "eval": "promptfoo eval -c promptfooconfig.yaml --repeat 3 --output eval/runs/latest.json",
    "eval:coverage": "tsx eval/coverage.ts",
    "eval:ceiling": "promptfoo eval -c promptfooconfig.ceiling.yaml --repeat 3",
    "eval:holdout": "EVAL_INCLUDE_HOLDOUT=1 promptfoo eval -c promptfooconfig.yaml --repeat 3",
    "eval:run": "tsx eval/run.ts",
    "eval:score": "tsx eval/score.ts",
    "eval:text": "tsx eval/run-text.ts",
    "eval:text:score": "tsx eval/score-text.ts",
    "eval:nutrients": "tsx eval/nutrients.ts"
  },
  "dependencies": {
    "@hono/zod-validator": "0.9.0",
    "drizzle-orm": "0.45.2",
    "hono": "4.12.34",
    "openai": "7.3.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@cloudflare/workers-types": "5.20260801.1",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.10",
    "drizzle-kit": "0.31.10",
    "promptfoo": "^0.121.20",
    "sharp": "0.35.3",
    "tsx": "^4.23.5",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "wrangler": "4.118.0"
  }
}
